<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cc_green_deep</item>
        <item name="colorOnPrimary">@color/cc_paper</item>
        <item name="colorSecondary">@color/cc_green</item>
        <item name="colorOnSecondary">@color/cc_paper</item>
        <item name="colorError">@color/cc_red</item>
        <item name="android:colorBackground">@color/cc_paper</item>
        <item name="colorSurface">@color/cc_paper_card</item>
        <item name="colorOnSurface">@color/cc_ink</item>
        <item name="colorSurfaceVariant">@color/cc_green_soft</item>
        <item name="colorOnSurfaceVariant">@color/cc_ink_soft</item>
        <item name="colorSecondaryContainer">@color/cc_green_deep</item>
        <item name="colorOnSecondaryContainer">@color/cc_paper</item>
        <item name="colorPrimaryContainer">@color/cc_green_soft</item>
        <item name="colorOnPrimaryContainer">@color/cc_green_deep</item>
        <item name="android:statusBarColor">@color/cc_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cc_paper</item>
    </style>

    <!-- Tela de ligação: capa do caderno (verde profundo) -->
    <style name="AppTheme.CallScreen">
        <item name="android:windowBackground">@color/cc_night_bg</item>
        <item name="android:statusBarColor">@color/cc_night_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/cc_night_bg</item>
        <item name="colorPrimary">@color/cc_green</item>
        <item name="colorOnPrimary">@color/cc_cream_on_dark</item>
    </style>

    <style name="AppTheme.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/cc_green_deep</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialKey" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/cc_green_deep</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
